import 'katex/dist/katex.min.css';

const INDEX_TO_KEY = ['A', 'B', 'C', 'D', 'E'];

const QuizCard = ({ 
    stepData, contextData, onSelect, isSubmitting, feedback, 
    allowRetry = false // ✅ 新增参数：是否允许在有反馈的情况下继续点击（用于错题本重做） 
}) => {
    
    const renderers = {
        p: ({children}) => <p className="mb-3 last:mb-0 leading-relaxed text-gray-700 dark:text-gray-300">{children}</p>,
        img: ({src, alt}) => <img src={src} alt={alt} className="rounded-xl my-4 max-h-64 object-contain mx-auto shadow-md border border-gray-200 dark:border-white/10" />
    };

    return (
        // ✅ 改动 1：外层唯一的滚动容器
        <div className="h-full overflow-y-auto custom-scrollbar scroll-smooth relative">
            
            {/* 内部弹性容器，保证最小高度占满父级 */}
            <div className="flex flex-col min-h-full p-8 md:p-10">
                
                {/* --- 1. 题干区域 --- */}
                {/* ✅ 改动 2：设置 min-h-[40%]，保证题目短时，选项也至少从中间往下开始排 */}
                <div className="w-full min-h-[40%] flex flex-col justify-center">
                    
                    {/* 宏观背景 */}
                    {contextData && (
                        <div className="mb-6 p-4 bg-blue-50/50 dark:bg-blue-500/10 rounded-2xl border border-blue-100 dark:border-blue-500/20">
                            <div className="flex items-center gap-2 mb-2">
                                <span className="px-2 py-0.5 bg-blue-500 text-white text-[10px] font-bold rounded uppercase tracking-wider opacity-80">
                                    Context
                                </span>
                            </div>
                            <div className="prose prose-sm prose-slate dark:prose-invert max-w-none opacity-80 line-clamp-3 hover:line-clamp-none transition-all cursor-default">
                                <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]} components={renderers}>
                                    {contextData.content.stem}
                                </ReactMarkdown>
                            </div>
                        </div>
                    )}

                    {/* 微观题干 */}
                    <div className="prose prose-xl prose-slate dark:prose-invert max-w-none">
                        <h3 className="font-bold mb-6 leading-snug text-gray-900 dark:text-white">
                            <span className="mr-3 opacity-20 text-lg align-middle font-mono">#{stepData.step_index}</span>
                            {stepData.stem}
                        </h3>
                    </div>

                    {/* 解析区域 */}
                    {feedback && (
                        <motion.div 
                            initial={{ opacity: 0, y: 5 }} 
                            animate={{ opacity: 1, y: 0 }} 
                            transition={{ duration: 0.3 }} 
                            className="mb-6 p-5 rounded-2xl bg-yellow-50 dark:bg-yellow-500/10 text-sm border border-yellow-100 dark:border-yellow-500/20 text-yellow-800 dark:text-yellow-200"
                        >
                            <span className="font-bold block mb-1 opacity-70 uppercase tracking-wide text-xs">Analysis</span>
                            <div>{stepData.analysis || "暂无解析"}</div>
                        </motion.div>
                    )}
                </div>

                {/* --- 2. 选项区域 --- */}
                {/* ✅ 修改：pb-20 改为 pb-10，别太靠底了 */}
                <div className="flex-1 flex flex-col justify-end pt-8 pb-10">
                    <div className="grid gap-4">
                        {stepData.options.map((opt, idx) => {
                            const optKey = INDEX_TO_KEY[idx];
                            
                            let statusClass = "border-gray-200 dark:border-white/10 hover:border-blue-400 dark:hover:border-blue-500 bg-white/50 dark:bg-white/5 hover:bg-blue-50 dark:hover:bg-white/10"; 
                            let iconClass = "border-gray-300 dark:border-white/20 text-gray-400 dark:text-gray-500";
                            let iconContent = optKey;

                            if (feedback) {
                                if (opt.is_correct) {
                                    statusClass = "border-green-500 bg-green-500 text-white shadow-xl shadow-green-500/20 transform scale-[1.02]";
                                    iconClass = "border-white text-white";
                                    iconContent = "✓";
                                } else if (feedback.selectedKey === opt.key) {
                                    statusClass = "border-red-500 bg-red-500 text-white shadow-xl shadow-red-500/20";
                                    iconClass = "border-white text-white";
                                    iconContent = "✕";
                                } else {
                                    statusClass = "border-transparent opacity-30 bg-gray-100 dark:bg-white/5 grayscale"; 
                                }
                            }

                            return (
                                <motion.button
                                    key={opt.key}
                                    whileHover={!feedback ? { scale: 1.01, x: 4 } : {}}
                                    whileTap={!feedback ? { scale: 0.98 } : {}}
                                    // ✅ 逻辑修改：如果开启了 allowRetry，即使有 feedback 也可以点击 
                                    onClick={() => (!feedback || allowRetry) && !isSubmitting && onSelect(opt.key)}
                                    className={`
                                        relative w-full p-5 rounded-2xl text-left font-medium border-2 transition-all duration-300 
                                        flex items-center gap-5 group backdrop-blur-sm
                                        ${statusClass}
                                    `}
                                >
                                    <div className={`shrink-0 w-8 h-8 rounded-full border-2 flex items-center justify-center text-sm font-bold transition-colors ${iconClass}`}>
                                        {iconContent}
                                    </div>
                                    <div className="flex-1 text-lg">
                                        <ReactMarkdown components={{ p: ({children})=><span>{children}</span> }} remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>
                                            {opt.content}
                                        </ReactMarkdown>
                                    </div>
                                </motion.button>
                            );
                        })}
                    </div>
                </div>

            </div>
        </div>
    );
};

export default QuizCard;
</file>

