<file path="frontend/src/components/MistakeCard.jsx">
import { useState } from "react";
import { motion } from "framer-motion";
import ReactMarkdown from 'react-markdown';
import remarkMath from 'remark-math';
import rehypeKatex from 'rehype-katex';
import 'katex/dist/katex.min.css';

const MistakeCard = ({ data }) => {
  // ✅ 补全状态定义
  const [isFlipped, setIsFlipped] = useState(false);
  const [selected, setSelected] = useState(null);
  const [isCorrect, setIsCorrect] = useState(null);

  // 处理重做逻辑
  const handleRetry = (key) => {
    if (isCorrect) return; 
    setSelected(key);
    
    if (key === data.correct_choice) {
      setIsCorrect(true);
      setTimeout(() => setIsFlipped(false), 1500); // 做对后自动翻回
    } else {
      setIsCorrect(false);
    }
  };

  return (
    <div className="relative w-full h-auto perspective-1000 mb-6 break-inside-avoid">
      <motion.div
        className="relative w-full transition-all duration-500 transform-style-3d"
        animate={{ rotateY: isFlipped ? 180 : 0 }}
        transition={{ duration: 0.6, type: "spring", stiffness: 260, damping: 20 }}
      >
        
        {/* === 正面：展示面 (Front) === */}
        <div className="w-full bg-white/80 dark:bg-[#1e293b]/80 backdrop-blur-xl border border-white/40 dark:border-white/10 rounded-3xl p-6 shadow-lg backface-hidden relative overflow-hidden group">
            
            {/* 顶部标签栏 */}
            <div className="flex flex-wrap gap-2 mb-4">
                <span className={`px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider border 
                    ${data.subject === 'Physics' ? 'bg-blue-100 text-blue-600 border-blue-200' : 
                      data.subject === 'Mathematics' ? 'bg-purple-100 text-purple-600 border-purple-200' : 
                      'bg-orange-100 text-orange-600 border-orange-200'}`}>
                    {data.subject}
                </span>
                {/* 错因标签 */}
                {data.diagnosis_tags && data.diagnosis_tags.map(tag => (
                    <span key={tag} className="px-2 py-1 rounded-md text-[10px] font-bold border bg-red-50 text-red-500 border-red-100 dark:bg-red-500/10 dark:border-red-500/20">
                        #{tag}
                    </span>
                ))}
            </div>

            {/* 题目快照 */}
            <div className="prose prose-sm prose-slate dark:prose-invert mb-4 opacity-90 line-clamp-4">
                <div className="font-bold text-base mb-1">
                    {data.type === 'composite' && <span className="mr-2 text-xs bg-gray-200 dark:bg-gray-700 px-1.5 py-0.5 rounded">Step {data.wrong_step_index + 1}</span>}
                    
                    {/* ✅ 修复：移除 className，确保内容是字符串 */}
                    <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>
                        {data.wrong_step_stem || data.stem_snapshot || ""}
                    </ReactMarkdown>
                </div>
            </div>

            {/* 底部数据栏 */}
            <div className="flex items-center justify-between mt-4 pt-4 border-t border-gray-100 dark:border-white/5">
                <div className="flex flex-col gap-1 w-1/2">
                    <span className="text-[10px] text-gray-400 font-bold uppercase">Mastery</span>
                    <div className="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                        <motion.div 
                            initial={{ width: 0 }} 
                            animate={{ width: `${data.mastery}%` }} 
                            className={`h-full ${isCorrect ? 'bg-green-500' : 'bg-red-500'}`} 
                        />
                    </div>
                </div>
                
                <button 
                    onClick={() => setIsFlipped(true)}
                    className="px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl text-xs font-bold shadow-lg hover:scale-105 active:scale-95 transition-transform"
                >
                    Retry
                </button>
            </div>
        </div>

        {/* === 背面：重做面 (Back) === */}
        <div 
            className="absolute top-0 left-0 w-full h-full bg-slate-900 dark:bg-black/90 backdrop-blur-xl border border-white/10 rounded-3xl p-6 shadow-xl backface-hidden rotate-y-180 flex flex-col justify-between"
            style={{ transform: "rotateY(180deg)" }}
        >
            <div className="text-white w-full">
                <h4 className="text-sm font-bold text-gray-400 mb-4 uppercase tracking-wider">Ghost Mode Retry</h4>
                <div className="space-y-2">
                    {Array.isArray(data.options_snapshot) && data.options_snapshot.map((opt) => (
                        <button
                            key={opt.key}
                            onClick={() => handleRetry(opt.key)}
                            disabled={isCorrect === true}
                            className={`w-full p-3 rounded-xl text-left text-sm font-medium border transition-all flex items-center
                                ${isCorrect === true && opt.is_correct ? 'bg-green-500 border-green-500 text-white' : 
                                  selected === opt.key && !opt.is_correct ? 'bg-red-500 border-red-500 text-white' : 
                                  'bg-white/5 border-white/10 hover:bg-white/10 text-gray-200'}
                            `}
                        >
                            <span className="mr-3 opacity-50 font-mono">{opt.key}.</span> 
                            <div className="flex-1">
                                {/* ✅ 修复：强制将 markdown 内容转为字符串，并移除 className */}
                                <div className="inline-markdown-fix">
                                    <ReactMarkdown 
                                        components={{ p: ({children}) => <span>{children}</span> }}
                                        remarkPlugins={[remarkMath]} 
                                        rehypePlugins={[rehypeKatex]}
                                    >
                                        {typeof opt.content === 'string' ? opt.content : String(opt.content)}
                                    </ReactMarkdown>
                                </div>
                            </div>
                        </button>
                    ))}
                </div>
            </div>
            
            {isCorrect && (
                <motion.div 
                    initial={{ scale: 0 }} animate={{ scale: 1 }}
                    className="absolute inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm rounded-3xl z-10"
                >
                    <div className="text-center">
                        <div className="text-4xl mb-2">🎉</div>
                        <div className="text-green-400 font-bold text-lg">Mastered!</div>
                        <div className="text-xs text-gray-400">+20 XP</div>
                    </div>
                </motion.div>
            )}

            <button 
                onClick={() => setIsFlipped(false)}
                className="mt-4 mx-auto text-xs text-gray-500 hover:text-white transition-colors"
            >
                Cancel
            </button>
        </div>

      </motion.div>
    </div>
  );
};

export default MistakeCard;
