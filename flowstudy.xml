};

const TopBar = () => {
  const [show, setShow] = useState(false);
  
  // ❌ 删除这一行本地状态: const [showSettings, setShowSettings] = useState(false);
  
  // ✅ 获取 focusSettings 
  const { isDark, setIsDark, bgOptions, changeBackground, showSettings, setShowSettings, focusSettings } = useTheme();

  // 倒计时 & 音乐逻辑
  const [timeLeft, setTimeLeft] = useState(focusSettings.duration * 60);
  const [isTimerRunning, setIsTimerRunning] = useState(false);
  const [isPlaying, setIsPlaying] = useState(false);
  const [isMuted, setIsMuted] = useState(false);
  const audioRef = useRef(new Audio("https://cdn.pixabay.com/audio/2022/05/27/audio_1808fbf07a.mp3"));
  
  // ✅ 监听设置变化：当用户在设置里修改时长时，如果倒计时没在跑，就自动更新显示时间 
  useEffect(() => { 
      if (!isTimerRunning) { 
          setTimeLeft(focusSettings.duration * 60); 
      } 
  }, [focusSettings.duration, isTimerRunning]); 

  useEffect(() => {
    let interval = null;
    if (isTimerRunning && timeLeft > 0) interval = setInterval(() => setTimeLeft(p => p - 1), 1000);
    else if (timeLeft === 0) { 
        setIsTimerRunning(false); 
        alert("Time is up!"); 
        // 倒计时结束重置为设定值 
        setTimeLeft(focusSettings.duration * 60); 
    }
    return () => clearInterval(interval);
  }, [isTimerRunning, timeLeft, focusSettings.duration]);

  const toggleMusic = () => {
      if(isPlaying) audioRef.current.pause(); else audioRef.current.play().catch(e=>{});
      setIsPlaying(!isPlaying);
  }

  return (
    <>
    {/* 触发区域：加宽加高，更容易触发 */}
    <div className="fixed top-0 left-0 w-full h-[30px] z-[90] flex justify-center group pointer-events-none">
      <div 
        className="w-[80%] h-full pointer-events-auto flex justify-center"
        onMouseEnter={() => setShow(true)}
        onMouseLeave={() => { setShow(false); }}
      >
        <AnimatePresence>
          {show && !showSettings && (
            <motion.div 
              initial={{ y: -100, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              exit={{ y: -100, opacity: 0 }}
              transition={{ type: "spring", stiffness: 180, damping: 25 }}
              // ✅ 样式升级：h-28 (更高), w-[90%] max-w-6xl (更宽), rounded-b-[3rem] (圆角更大) 
              className="absolute top-0 w-[95%] md:w-[90%] max-w-6xl h-28 
                         dark:bg-black/80 bg-white/90 backdrop-blur-2xl 
                         border-b border-x dark:border-white/10 border-white/40 
                         dark:text-white text-gray-800 
                         rounded-b-[3rem] flex items-center justify-between px-12 shadow-2xl z-[91]"
            >
              {/* 1. 番茄钟 Section - 尺寸加大，增加标签 */}
              <div className="flex items-center gap-5">
                <button 
                    onClick={() => setIsTimerRunning(!isTimerRunning)}
                    className={`w-14 h-14 rounded-full flex items-center justify-center transition-all duration-300 shadow-xl hover:scale-110 active:scale-95 
                    ${isTimerRunning ? 'bg-pink-500 text-white shadow-pink-500/40' : 'dark:bg-white/10 bg-gray-100 text-pink-500 hover:bg-pink-50 dark:hover:bg-white/20'}`}
                >
                   {/* 图标放大 */}
                   <span className="transform scale-125">{isTimerRunning ? <Icons.Pause /> : <Icons.Stopwatch />}</span>
                </button>
                <div className="flex flex-col cursor-pointer select-none group/timer" onClick={()=>{setIsTimerRunning(false); setTimeLeft(25*60);}}>
                    <span className="text-[10px] font-bold uppercase tracking-widest opacity-40 mb-0.5 group-hover/timer:text-pink-500 transition-colors">Focus Timer</span>
                    <div className="font-mono text-4xl font-black tracking-wider dark:text-white text-gray-800 drop-shadow-sm tabular-nums leading-none">
                        {`${Math.floor(timeLeft / 60).toString().padStart(2, '0')}:${(timeLeft % 60).toString().padStart(2, '0')}`}
                    </div>
                </div>
              </div>

              {/* 2. 音乐 Section - 胶囊式布局，增加层次感 */}
              <div className="flex flex-col items-center gap-1.5">
                 <span className="text-[10px] font-bold uppercase tracking-widest opacity-40 flex items-center gap-2">
                    <span className={`w-1.5 h-1.5 rounded-full ${isPlaying ? 'bg-green-500 animate-pulse' : 'bg-gray-400'}`}></span> Lo-Fi Radio
                 </span>
                 <div className="flex items-center gap-6 px-6 py-2 rounded-2xl dark:bg-white/5 bg-gray-100/80 border border-transparent dark:border-white/5 shadow-inner">
                    <span className="cursor-pointer hover:scale-125 hover:text-blue-500 transition opacity-60 hover:opacity-100"><Icons.Backward /></span>
                    <button onClick={toggleMusic} className="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 text-white flex items-center justify-center shadow-lg hover:scale-110 hover:shadow-blue-500/40 transition-all active:scale-95">
                        {isPlaying ? <Icons.Pause /> : <Icons.Play className="ml-0.5 w-4 h-4" />}
                    </button>
                    <span className="cursor-pointer hover:scale-125 hover:text-blue-500 transition opacity-60 hover:opacity-100"><Icons.Forward /></span>
                 </div>
              </div>

              {/* 3. 设置入口 - 整合为工具栏 */}
              <div className="flex items-center bg-gray-100/80 dark:bg-white/5 rounded-full px-5 py-3 gap-4 border border-transparent dark:border-white/5 shadow-sm">
                  <button onClick={() => {audioRef.current.muted = !isMuted; setIsMuted(!isMuted)}} className="opacity-60 hover:opacity-100 transition hover:text-blue-500 hover:scale-110">
                      {isMuted ? <Icons.VolumeXmark /> : <Icons.VolumeHigh />}
                  </button>
                  <div className="w-px h-5 bg-current opacity-10"></div>
                  <button 
                    onClick={() => setShowSettings(true)} 
                    className="opacity-60 hover:opacity-100 transition hover:rotate-90 duration-500 hover:text-blue-500 hover:scale-110"
                  >
                    <Icons.Gear />
                  </button>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
        
        {!showSettings && (
             <div className="absolute bottom-2 w-24 h-1 bg-gray-400/30 dark:bg-white/20 backdrop-blur rounded-full transition-all duration-300 group-hover:opacity-0 shadow-sm" />
        )}
      </div>
    </div>

    {/* ❌ 旧的 AnimatePresence 弹窗已删除
     现在弹窗由 App.jsx 里的 SettingsModal 负责渲染，这里不需要写了 */}
    </>
  );
};

export default TopBar;
</file>

