  const [viewMode, setViewMode] = useState("split");
  
  // ✅ 新增：控制是否显示答案和笔记
  const [isRevealed, setIsRevealed] = useState(false);

  // 切换题目时重置遮罩
  useEffect(() => {
      setIsRevealed(false);
  }, [mistake]);

  const handleInteract = (key) => {
      // 用户做了题，或者点击了 Peek，解锁内容
      setIsRevealed(true);
  };

  // 构造 QuizCard 数据
  const mistakeStepData = mistake ? {
      step_index: mistake.wrong_step_index + 1,
      stem: mistake.wrong_step_stem,
      options: mistake.options_snapshot,
      analysis: mistake.diagnosis_tags ? `【诊断】${mistake.diagnosis_tags.join(", ")}` : "暂无诊断"
  } : null;

  // Markdown 配置
  const renderers = {
      p: ({children}) => <p className="mb-3 leading-relaxed">{children}</p>,
      h1: ({children}) => <h1 className="text-xl font-bold mb-4 border-b border-gray-200 dark:border-white/10 pb-2">{children}</h1>,
      h2: ({children}) => <h2 className="text-lg font-bold mb-3 mt-6">{children}</h2>,
      ul: ({children}) => <ul className="list-disc list-inside mb-4 space-y-1">{children}</ul>,
  };

  return (
