import { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { motion, AnimatePresence } from "framer-motion";

// 图标
const Icons = {
  ArrowLeft: ({className}) => <svg viewBox="0 0 24 24" fill="currentColor" className={className}><path fillRule="evenodd" d="M11.03 3.97a.75.75 0 010 1.06l-6.22 6.22H21a.75.75 0 010 1.5H4.81l6.22 6.22a.75.75 0 11-1.06 1.06l-7.5-7.5a.75.75 0 010-1.06l7.5-7.5a.75.75 0 011.06 0z" clipRule="evenodd" /></svg>,
  Brain: ({className}) => <svg viewBox="0 0 24 24" fill="currentColor" className={className}><path d="M12 1.5a.75.75 0 01.75.75V7.5h-1.5V2.25A.75.75 0 0112 1.5zM11.25 7.5v5.69l-1.72-1.72a.75.75 0 00-1.06 1.06l3 3a.75.75 0 001.06 0l3-3a.75.75 0 10-1.06-1.06l-1.72 1.72V7.5h3.75a3 3 0 013 3v9a3 3 0 01-3 3h-9a3 3 0 01-3-3v-9a3 3 0 013-3h3.75z" /></svg>, // 简化的脑图
  Check: ({className}) => <svg viewBox="0 0 24 24" fill="currentColor" className={className}><path fillRule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 011.04-.207z" clipRule="evenodd" /></svg>,
};

// 模拟预制知识点数据 (未来从 backend/knowledge_cards 获取)
const MOCK_ANKI_CARDS = [
    {
        id: "kc_01",
        tag: "竖直平面圆周运动",
        type: "concept",
        front: "轻绳模型通过最高点的临界条件是什么？",
        back: "重力恰好提供向心力：\n\n$$mg = m\\frac{v^2}{R}$$\n\n即 $v = \\sqrt{gR}$。此时绳子拉力 $T=0$。",
        source_mistake_id: "m_001"
    },
    {
        id: "kc_02",
        tag: "函数单调性",
        type: "trap",
        front: "判断 $f(x) = \\ln x - x$ 单调性时最容易忽略的一步是？",
        back: "**定义域！定义域！定义域！**\n\n一定要先写出 $x > 0$，否则解不等式会得到 $x < 1$ 从而误选 $(-\\infty, 1)$。",
        source_mistake_id: "m_002"
    },
    {
        id: "kc_03",
        tag: "虚拟语气",
        type: "grammar",
        front: "If I _____ you, I would... (be)",
        back: "**were**\n\n在虚拟语气中，与现在事实相反的假设，be 动词一律用 were，不管人称。",
        source_mistake_id: "m_003"
    }
];

const AnkiPage = () => {
  const navigate = useNavigate();
  const [queue, setQueue] = useState(MOCK_ANKI_CARDS);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isFlipped, setIsFlipped] = useState(false);
  const [finished, setFinished] = useState(false);

  // 当前卡片
  const currentCard = queue[currentIndex];

  const handleNext = (quality) => {
      // quality: 'forgot' | 'hard' | 'easy'
      // 这里可以调用后端 API 更新下次复习时间
      console.log(`Card ${currentCard.id} rated: ${quality}`);

      if (currentIndex < queue.length - 1) {
          setIsFlipped(false);
          setTimeout(() => setCurrentIndex(prev => prev + 1), 200); // 稍微延迟让翻转动画归位
      } else {
          setFinished(true);
      }
  };

  if (finished) return (
      <div className="fixed inset-0 bg-transparent flex flex-col items-center justify-center text-white font-sans">
          <motion.div initial={{scale:0}} animate={{scale:1}} className="text-center p-10 bg-black/40 backdrop-blur-xl rounded-3xl border border-white/10">
              <div className="text-6xl mb-4">🎉</div>
              <h2 className="text-3xl font-bold mb-2">All Caught Up!</h2>
              <p className="opacity-60 mb-8">今天的记忆任务已完成。</p>
              <button onClick={() => navigate('/')} className="px-8 py-3 bg-white text-black rounded-full font-bold hover:scale-105 transition">Back to Dashboard</button>
          </motion.div>
      </div>
  );

  return (
    <div className="fixed inset-0 bg-transparent text-slate-800 dark:text-slate-100 font-sans overflow-hidden flex flex-col">
      
      {/* 顶部进度 */}
      <div className="h-20 absolute top-0 left-0 w-full flex items-center justify-between px-8 z-50 pt-4 pointer-events-none">
        <button onClick={() => navigate('/')} className="pointer-events-auto flex items-center gap-2 bg-white/80 dark:bg-slate-900/60 backdrop-blur-md px-5 py-2.5 rounded-full border border-white/20 shadow-lg hover:scale-105 transition-all text-sm font-bold">
            <Icons.ArrowLeft className="w-5 h-5" /> <span>Quit</span>
        </button>
        <div className="px-4 py-2 rounded-full bg-black/20 backdrop-blur-md font-mono font-bold text-white/80 border border-white/10">
            {currentIndex + 1} / {queue.length}
        </div>
      </div>

      {/* 核心卡片区 */}
      <div className="flex-1 flex items-center justify-center p-6 relative perspective-1000">
        <AnimatePresence mode="wait">
            <motion.div
                key={currentCard.id}
                initial={{ opacity: 0, x: 50, rotate: 2 }}
                animate={{ opacity: 1, x: 0, rotate: 0 }}
                exit={{ opacity: 0, x: -50, rotate: -2 }}
                transition={{ type: "spring", stiffness: 200, damping: 20 }}
                className="relative w-full max-w-xl aspect-[3/4] md:aspect-[4/3] transform-style-3d cursor-pointer"
                onClick={() => !isFlipped && setIsFlipped(true)}
            >
                {/* 容器动画：控制翻转 */}
                <motion.div 
                    className="w-full h-full relative transform-style-3d transition-all duration-500"
                    animate={{ rotateY: isFlipped ? 180 : 0 }}
                >
                    {/* === 正面 (Front) === */}
                    <div className="absolute inset-0 bg-white dark:bg-[#1e293b] rounded-[2.5rem] shadow-2xl border border-gray-200 dark:border-white/10 backface-hidden flex flex-col items-center justify-center p-10 text-center">
                        <span className="absolute top-8 left-8 px-3 py-1 bg-blue-100 dark:bg-blue-500/20 text-blue-600 dark:text-blue-300 text-xs font-bold uppercase tracking-wider rounded-lg">
                            {currentCard.type}
                        </span>
                        <h3 className="text-3xl font-bold leading-snug dark:text-white text-gray-900">
                            {currentCard.front}
                        </h3>
                        <p className="mt-8 text-sm text-gray-400 font-bold uppercase tracking-widest animate-pulse">Tap to Flip</p>
                    </div>

                    {/* === 背面 (Back) === */}
                    <div 
                        className="absolute inset-0 bg-slate-900 dark:bg-black rounded-[2.5rem] shadow-2xl border border-white/10 backface-hidden flex flex-col p-10 rotate-y-180"
                        style={{ transform: "rotateY(180deg)" }}
                    >
                        <div className="flex-1 flex flex-col justify-center text-center overflow-y-auto custom-scrollbar">
                            <h3 className="text-xl font-bold text-gray-400 mb-4 line-through opacity-50">{currentCard.front}</h3>
                            <div className="text-2xl text-white font-medium leading-relaxed whitespace-pre-line">
                                {currentCard.back}
                            </div>
                            {currentCard.source_mistake_id && (
                                <div className="mt-8 pt-4 border-t border-white/10">
                                    <span className="text-xs text-blue-400 font-bold uppercase tracking-wider cursor-pointer hover:underline hover:text-blue-300">
                                        🔗 源自错题 #{currentCard.source_mistake_id}
                                    </span>
                                </div>
                            )}
                        </div>
                    </div>
                </motion.div>
            </motion.div>
        </AnimatePresence>
      </div>

      {/* 底部控制栏 (只在翻面后显示) */}
      <div className="h-32 flex items-start justify-center pt-4 z-50">
          {isFlipped && (
              <motion.div 
                initial={{ y: 50, opacity: 0 }}
                animate={{ y: 0, opacity: 1 }}
                className="flex gap-4"
              >
                  <button onClick={() => handleNext('forgot')} className="flex flex-col items-center gap-1 group">
                      <div className="w-16 h-16 rounded-2xl bg-red-500 flex items-center justify-center text-white shadow-lg shadow-red-500/30 transition-transform group-hover:scale-110 active:scale-95">
                          <span className="font-bold text-xl">1m</span>
                      </div>
                      <span className="text-xs font-bold text-red-400 uppercase">Forgot</span>
                  </button>
                  <button onClick={() => handleNext('hard')} className="flex flex-col items-center gap-1 group">
                      <div className="w-16 h-16 rounded-2xl bg-yellow-500 flex items-center justify-center text-white shadow-lg shadow-yellow-500/30 transition-transform group-hover:scale-110 active:scale-95">
                          <span className="font-bold text-xl">10m</span>
                      </div>
                      <span className="text-xs font-bold text-yellow-400 uppercase">Hard</span>
                  </button>
                  <button onClick={() => handleNext('easy')} className="flex flex-col items-center gap-1 group">
                      <div className="w-16 h-16 rounded-2xl bg-green-500 flex items-center justify-center text-white shadow-lg shadow-green-500/30 transition-transform group-hover:scale-110 active:scale-95">
                          <span className="font-bold text-xl">4d</span>
                      </div>
                      <span className="text-xs font-bold text-green-400 uppercase">Easy</span>
                  </button>
              </motion.div>
          )}
      </div>

    </div>
  );
};

export default AnkiPage;
