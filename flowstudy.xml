            <div className="p-3 bg-yellow-500/20 rounded-2xl text-yellow-500"><Icons.BookOpen /></div>
            <div className="text-right"><span className="text-3xl font-bold block dark:text-white text-gray-900">{stats.notes_count}</span></div>
          </div>
          <div className="mt-6 relative z-10"><h3 className="font-semibold text-lg dark:text-white text-gray-900">随手笔记</h3><p className="text-xs text-gray-500 mt-1">管理笔记</p></div>
        </GlassCard>

        <GlassCard className="col-span-1 md:col-span-2 p-5 flex items-center gap-5" delay={0.5}>
          <div className="w-16 h-16 rounded-xl bg-indigo-500 shadow-lg shrink-0 flex items-center justify-center"><Icons.Play /></div>
          <div><h3 className="font-bold text-lg dark:text-white text-gray-900">Lofi Study Girl</h3><p className="text-xs text-gray-500">控制请使用顶部隐藏栏</p></div>
        </GlassCard>
      </main>
    </div>
  );
}

export default Dashboard;
