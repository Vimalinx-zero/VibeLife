                 const res = await axios.get(`http://localhost:8000/api/card/preview?type=${type}&id=${cleanId}`); 
                 if (isMounted) { 
                     if (res.data.found) { 
                         setData(res.data); 
                     } else { 
                         setError(true); 
                     } 
                     setLoading(false); 
                 } 
             } catch (e) { 
                 if (isMounted) { 
                     setError(true); 
                     setLoading(false); 
                 } 
             } 
         }; 
         fetchData(); 
         return () => { isMounted = false; }; 
     }, [type, id]); 
 
     // 1. 加载中状态 (显示骨架屏) 
     if (loading) { 
         return ( 
             <span className="inline-block w-64 h-24 align-middle mx-1 my-2 bg-gray-100 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 animate-pulse"></span> 
         ); 
     } 
 
     // 2. 错误状态 (回退到普通文本链接) 
     if (error || !data) { 
         return <span className="text-red-400 bg-red-50 dark:bg-red-900/20 px-2 py-1 rounded text-xs font-mono border border-red-200">⚠️ {originalText} (Not Found)</span>; 
     } 
 
     // 3. 渲染漂亮的卡片 
    return ( 
        <motion.div 
            layout 
            className={` 
                my-4 block w-full max-w-2xl text-left 
                bg-white dark:bg-[#1e293b]/80 backdrop-blur-md 
                border border-gray-200 dark:border-white/10 rounded-xl 
                shadow-sm hover:shadow-md transition-all cursor-pointer overflow-hidden 
                group select-none relative 
            `} 
            onClick={() => setExpanded(!expanded)} 
        > 
            {/* 左侧装饰条 */} 
            <div className={`absolute left-0 top-0 bottom-0 w-1 ${type === 'question' ? 'bg-blue-500' : 'bg-yellow-500'}`} /> 
            
            <div className="p-4 pl-6"> 
                {/* 头部：ID 和 标签 */} 
                <div className="flex items-center gap-2 mb-2"> 
                    <span className={` 
                        px-1.5 py-0.5 rounded text-[10px] font-bold font-mono uppercase tracking-wider 
                        ${type === 'question' ? 'bg-blue-100 text-blue-600 dark:bg-blue-500/20 dark:text-blue-300' : 'bg-yellow-100 text-yellow-600 dark:bg-yellow-500/20 dark:text-yellow-300'} 
                    `}> 
                        {type === 'question' ? id.replace('gk_', '') : 'NOTE'} 
                    </span> 
                    
                    {/* 标签列表 */} 
                    <div className="flex gap-2 overflow-hidden opacity-60"> 
                        {data.tags && data.tags.map((tag, i) => ( 
                            <span key={i} className="text-[10px] text-gray-500 dark:text-gray-400 whitespace-nowrap"> 
                                #{tag} 
                            </span> 
                        ))} 
                    </div> 
                </div> 

                {/* 内容区域 */} 
                <div className="text-gray-800 dark:text-gray-100 text-sm leading-relaxed font-sans"> 
                    {/* 标题 (如果是笔记) */} 
                    {type === 'note' && <div className="font-bold mb-1 text-base">{data.title}</div>} 
                    
                    {/* 正文摘要 */} 
                    <div className={`${expanded ? '' : 'line-clamp-3'} transition-all`}> 
                        {data.body} 
                    </div> 
                </div> 
            </div> 
        </motion.div> 
    ); 
 }; 
 
 export default SmartLink;
</file>

