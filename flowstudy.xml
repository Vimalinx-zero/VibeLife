            animate={{ width: viewMode === 'problem' ? '100%' : (viewMode === 'split' ? '50%' : '0%'), opacity: viewMode === 'note' ? 0 : 1 }}
            transition={{ type: "spring", stiffness: 120, damping: 20 }} 
