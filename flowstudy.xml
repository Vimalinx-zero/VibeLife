                       <AnimatePresence> 
                           {filteredMistakes.map((item) => ( 
                               // ✅ 使用新组件 MistakeCard 
                               <MistakeCard key={item.id} data={item} /> 
                           ))} 
                       </AnimatePresence> 
                   </div> 
                   
                   {filteredMistakes.length === 0 && ( 
                       <div className="h-64 flex flex-col items-center justify-center opacity-50"> 
                           <p className="text-xl font-bold">No mistakes found.</p> 
                           <p className="text-sm">Keep practicing!</p> 
                       </div> 
