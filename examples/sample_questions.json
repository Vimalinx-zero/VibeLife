        "macro_tags": {
          "scenario_model": "语法",
          "competency": "应用",
          "grade": "高中",
          "chapter": "时态",
          "topic": "现在完成时"
        }
      },
      "content": {
        "stem": "I _____ the book twice.",
        "media": {
          "image_url": null,
          "audio_url": null,
          "video_url": null
        }
      },
      "steps": [
        {
          "step_index": 0,
          "step_id": "s_001",
          "interaction_type": "single_choice",
          "stem": "选择正确的动词形式",
          "analysis": "考察现在完成时的构成",
          "options": [
            {
              "key": "A",
              "content": "read",
              "is_correct": false,
              "gain_micro_tags": [],
              "diagnosis": {
                "knowledge_gap": ["时态构成"],
                "cognitive_flaw": "时态混淆",
                "severity": "medium",
                "hint": "表示过去发生的动作对现在造成的影响，应用现在完成时"
              }
            },
            {
              "key": "B",
              "content": "have read",
              "is_correct": true,
              "gain_micro_tags": ["现在完成时", "动词变形"],
              "diagnosis": null
            },
            {
              "key": "C",
              "content": "reads",
              "is_correct": false,
              "gain_micro_tags": [],
              "diagnosis": {
                "knowledge_gap": ["时态用法"],
                "cognitive_flaw": "时态错误",
                "severity": "low",
                "hint": "一般现在时表示经常性动作，不符合语境"
              }
            },
            {
              "key": "D",
              "content": "am reading",
              "is_correct": false,
              "gain_micro_tags": [],
              "diagnosis": {
                "knowledge_gap": ["时态用法"],
                "cognitive_flaw": "语境理解错误",
                "severity": "medium",
                "hint": "现在进行时表示正在进行的动作，但'twice'表示已完成的次数"
              }
            }
          ]
        }
      ],
      "summary": {
        "answer": "B",
        "explanation": "现在完成时构成：have/has + 过去分词。表示过去发生的动作对现在造成的影响。'twice'表示动作已完成两次，对现在的影响是已经读过两遍。",
        "key_points": [
          "现在完成时：have/has + 过去分词",
          "read 的过去分词还是 read",
          "现在完成时强调对现在的影响"
        ],
        "extended_reading": "现在完成时与一般过去时的区别：一般过去时只强调过去的动作，与现在无关；现在完成时强调过去的动作对现在的影响。"
      }
    }
  ]
